BIN  = dcemu.exe
CXXFLAGS = $(CXXINCS)  -fverbose-asm -O1 -g3
CFLAGS = $(INCS)-Wall   -fverbose-asm -O1 -g3

.PHONY: all all-before all-after clean clean-custom

all: all-before dcemu.exe all-after


clean: clean-custom
	rm -f $(OBJ) $(BIN)

$(BIN): $(OBJ)
	$(CC) $(LINKOBJ) -o "dcemu.exe" $(LIBS)

