INCS =  -I"C:/Dev-Cpp/include"  -I"C:/lib_sdl/SDL-devel-1.2.7-mingw32/include/SDL"  -I"C:/lib_sdl/SDL_ttf-2.0.6/include/SDL"  -I"C:/lib_sdl/SDL_image-1.2.3/include/SDL"  -I"C:/lib_sdl/sdlconsole-2.1/include" 
