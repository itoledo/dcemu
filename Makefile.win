./obj/gui.o: gui.cpp
	$(CPP) -c gui.cpp -o ./obj/gui.o $(CXXFLAGS)

./obj/glops.o: glops.c
	$(CC) -c glops.c -o ./obj/glops.o $(CFLAGS)

./obj/dcemu_private.res: dcemu_private.rc 
	$(WINDRES) -i dcemu_private.rc --input-format=rc -o ./obj/dcemu_private.res -O coff 
