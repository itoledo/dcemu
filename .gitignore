# Archivo CVS/RCS original, conservado como respaldo fuera del control de versiones
_cvsroot/

# Resultado de la compilacion
# (las librerias .a de lib/ si van versionadas: son dependencias en el arbol)
*.o

# Intermedios del toolchain de KOS en demos/. El .bin si va versionado, como
# demos/roto/roto.bin: asi la demo se puede correr sin tener el SDK instalado.
*.elf
obj/*.res
dcemu.exe
/dcemu

# CMake / MSVC
/build/
/out/
CMakeUserPresets.json

# Logs generados en tiempo de ejecucion
logs/*.txt
!logs/remove.txt

# BIOS e imagenes de disco (no se distribuyen)
bios/
*.iso
*.cue
*.gdi
1st_read.bin
ip.bin
.vs/
roms/
