# Archivo CVS/RCS original, conservado como respaldo fuera del control de versiones
_cvsroot/

# Resultado de la compilacion
# (las librerias .a de lib/ si van versionadas: son dependencias en el arbol)
*.o

# Intermedios del toolchain de KOS en demos/. El .bin si va versionado, como
# demos/roto/roto.bin: asi la demo se puede correr sin tener el SDK instalado.
*.elf
obj/*.res
dcemu.exe
/dcemu

# CMake / MSVC
/build/
/out/
CMakeUserPresets.json

# Logs generados en tiempo de ejecucion
logs/*.txt
!logs/remove.txt

# BIOS e imagenes de disco (no se distribuyen).
#
# roms/ no alcanzaba: el directorio se agrego aqui **despues** de que sus
# archivos ya estuvieran versionados, y .gitignore no desversiona lo que ya
# esta dentro. Quedaron 1,5 GB en el historial -- un .cdi de 814 MB y un .ecm
# de 715 -- que no se veian en `git status` y solo aparecian al empujar la rama.
# Por eso van tambien las extensiones: una imagen de disco no se versiona
# **este donde este**.
bios/
roms/
*.iso
*.cue
*.gdi
*.cdi
*.ecm
*.chd
1st_read.bin
ip.bin
.vs/

# Documentacion de referencia de Sega, que se baja aparte: son 2,5 MB de binario
# y no va versionada. Ver docs/pendientes-plan.md, via B.
docs/*.pdf
docs/*.doc
scrambled.bin
descrambled.bin
